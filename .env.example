# ─── Google Calendar (server-side OAuth) ──────────────────────────────────────
# These are SERVER vars, set in the Vercel dashboard, not VITE_ vars. The
# browser never sees a Google credential any more.
#
# Setup, once, at https://console.cloud.google.com:
#   1. APIs & Services -> Library -> enable "Google Calendar API"
#   2. Credentials -> Create Credentials -> OAuth 2.0 Client ID -> Web application
#   3. Authorized redirect URI:
#        https://higrade-invoicing.vercel.app/api/gcal-auth
#      (add http://localhost:3000/api/gcal-auth too if you run vercel dev)
#   4. Copy the client ID and client secret below
#   5. OAuth consent screen -> PUBLISH TO PRODUCTION.
#      Left in "Testing", Google expires the refresh token after 7 days and the
#      calendar starts disconnecting weekly. This is the whole reason the old
#      browser flow was replaced, so do not skip it.
GOOGLE_OAUTH_CLIENT_ID=your_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_client_secret_here
# Optional. Derived from the request host when unset; set it only if the app is
# served from a domain other than the one Google redirects back to.
# GOOGLE_OAUTH_REDIRECT_URI=https://higrade-invoicing.vercel.app/api/gcal-auth

# Required by /api/gcal — the google_credentials table is service-role only.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Supabase — note: Vercel env vars must use the VITE_ prefix to be accessible in the browser
VITE_SUPABASE_URL=https://cwhgcxxszyvevjpbnnkc.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Deprecated: the browser implicit flow that VITE_GOOGLE_CLIENT_ID drove issued
# a one-hour token with no refresh token, so the calendar disconnected hourly
# and separately in every browser. Replaced by the two vars at the top. Nothing
# reads this any more except as a fallback for GOOGLE_OAUTH_CLIENT_ID.
# VITE_GOOGLE_CLIENT_ID=your_client_id_here
